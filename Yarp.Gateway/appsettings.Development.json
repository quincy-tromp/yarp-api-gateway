{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products",
        "Match": {
          "Path": "api/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Append": "YarpLearning",
            "When": "Success"
          }
        ]     
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Append": "YarpLearning",
            "When": "Success"
          }
        ]
      },
      "overview": {
        "ClusterId": "overview",
        "Match": {
          "Path": "api/overview"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Append": "YarpLearning",
            "When": "Success"
          }
        ]
      }
    },
    "Clusters": {
      "products": {
        "Destinations": {
          "products-api": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "orders": {
        "Destinations": {
          "orders-api": {
            "Address": "https://localhost:6001"
          }
        }
      },
      "overview": {
        "Destinations": {
          "overview-bff": {            "Address": "https://localhost:7001"
          }
        }
      }
    }
  }
}
