{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "__ConnectionString__",
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "__Authority__",
    "Issuer": "__Issuer__",
    "Audiences": [
      "__ProudctApiClientId__",
      "__OrderApiClientId__",
      "__OverviewBffClientId__"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products",
        "AuthorizationPolicy": "Products.Api.Access",
        "Timeout": "00:00:05",
        "Match": {
          "Path": "api/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Append": "YarpLearning",
            "When": "Success"
          }
        ]
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "Orders.Api.Access",
        "Timeout": "00:00:05",
        "Match": {
          "Path": "api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Append": "YarpLearning",
            "When": "Success"
          }
        ]
      },
      "overview": {
        "ClusterId": "overview",
        "AuthorizationPolicy": "Overview.Bff.Access",
        "Timeout": "00:00:10",
        "Match": {
          "Path": "api/overview"
        },
        "CorsPolicy": "ReadOnly",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Append": "YarpLearning",
            "When": "Success"
          }
        ]
      }
    },
    "Clusters": {
      "products": {
        "Destinations": {
          "productsapi": {
            "Address": "__Address__"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "orders": {
        "Destinations": {
          "ordersapi": {
            "Address": "__Address__"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      },
      "overview": {
        "Destinations": {
          "overviewbff": {
            "Address": "__Address__"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        }
      }
    }
  }
}
