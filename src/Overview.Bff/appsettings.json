{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "__ConnectionString__",
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "ClientId": "__ClientId__",
    "TenantId": "__TenantId__",
    "ClientCredentials": [
      {
        "SourceType": "ClientSecret",
        "ClientSecret": "__ClientSecret__"
      }
    ]
  },
  "ExternalApis": {
    "Products": {
      "BaseUrl": "__BaseUrl__",
      "Scopes": [ "Products.Read" ]
    },
    "Orders": {
      "BaseUrl": "__BaseUrl__",
      "Scopes": [ "Orders.Read" ]
    }
  }
}
